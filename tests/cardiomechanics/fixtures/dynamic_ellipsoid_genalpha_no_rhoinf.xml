<settings>GeneralizedAlpha without RhoInf: initialisation has to abort</settings>

<General>
    <LogFile>Results/dynamic.log</LogFile>
</General>

<Mesh>
    <Type>T10</Type>
    <Format>Tetgen</Format>
    <Sorting>PCA</Sorting>

    <Tetgen>
        <Unit>1e-3</Unit>
        <Nodes>./tetgen/ellipsoid.node</Nodes>
        <Elements>./tetgen/ellipsoid.ele</Elements>
        <Surfaces>./tetgen/ellipsoid.sur</Surfaces>
        <Bases>./tetgen/ellipsoid.bases</Bases>
        <DetermineNeighbors>true</DetermineNeighbors>
        <EnforceOrthonormalBases>true</EnforceOrthonormalBases>
    </Tetgen>

    <Surfaces>
        <!-- Endo -->
        <Surface_1><Type>T3</Type></Surface_1>
        <!-- Epi -->
        <Surface_2><Type>T3</Type></Surface_2>
        <!-- Base -->
        <Surface_3><Type>T3</Type></Surface_3>
    </Surfaces>
</Mesh>

<Materials>
    <Global>
        <Damping>
            <Type>Rayleigh</Type>
            <Rayleigh>
                <Alpha>500</Alpha>
                <Beta>0.005</Beta>
            </Rayleigh>
        </Damping>
    </Global>
    <Mat_30>
        <IgnoreCorruptElements>false</IgnoreCorruptElements>
        <Type>Guccione</Type>
        <Density>1082</Density>
        <Guccione>
            <C>2000.0</C>
            <bf>8.</bf>
            <bt>2.</bt>
            <bfs>4.</bfs>
            <K>1e6</K>
        </Guccione>
        <TensionMax>60000</TensionMax>
        <TensionModel>FromFunction</TensionModel>
        <FromFunction>
            <Type>Linear</Type>
            <StartTime>0.0</StartTime>
            <StopTime>0.2</StopTime>
        </FromFunction>
    </Mat_30>
</Materials>

<Export>
    <Format>VTK</Format>
    <Prefix>Results/dynamic</Prefix>
    <TimeStep>0.01</TimeStep>
</Export>

<Solver>
    <NonZeros>2000</NonZeros>
    <DomainDecomposition>false</DomainDecomposition>
    <Precision>1e-8</Precision>
    <Verbose>true</Verbose>
    <LU>true</LU>

    <Type>GeneralizedAlpha</Type>

    <Formulation>TotalLagrangian</Formulation>

    <StartTime>0</StartTime>
    <StopTime>0.2</StopTime>
    <TimeStep>1e-3</TimeStep>

    <Plugins>
        <ApplyPressureFromFunction>true</ApplyPressureFromFunction>
    </Plugins>
</Solver>

<Plugins>
    <ApplyPressureFromFunction>
        <ExportFile>Results/Pressure.dat</ExportFile>
        <Groups>
            <RampUp>
                <!-- linear ramp to an endocardial pressure of 15 kPa -->
                <Surfaces>1</Surfaces>
                <Intervals>
                    <Interval_1>
                        <Type>Linear</Type>
                        <Invert>false</Invert>
                        <StartTime>0.0</StartTime>
                        <StopTime>0.2</StopTime>
                        <Offset>0</Offset>
                        <Amplitude>-15000</Amplitude>
                    </Interval_1>
                </Intervals>
            </RampUp>
        </Groups>
    </ApplyPressureFromFunction>
</Plugins>
