<settings>Rigid rotation of a distorted box</settings>

<General>
    <LogFile>./Results/box.log</LogFile>
</General>

<Mesh>
    <Type>T10P1</Type>
    <Format>Tetgen</Format>
    <!-- The points-control plugin addresses nodes by their index in box.node. -->
    <Sorting>None</Sorting>

    <Tetgen>
        <Unit>1</Unit>
        <Nodes>./tetgen/box.node</Nodes>
        <Elements>./tetgen/box.ele</Elements>
    </Tetgen>
</Mesh>

<Materials>
    <Mat_30>
        <Type>NeoHooke</Type>
        <Density>1</Density>
        <NeoHooke>
            <a>1</a>
            <k>1000</k>
        </NeoHooke>
        <TensionMax>0</TensionMax>
    </Mat_30>
</Materials>

<Export>
    <Format>VTK</Format>
    <Prefix>./Results/box</Prefix>
    <TimeStep>0.125</TimeStep>
</Export>

<Solver>
    <NonZeros>2000</NonZeros>
    <DomainDecomposition>false</DomainDecomposition>
    <Precision>1e-12</Precision>
    <!-- Coordinates are O(1) here, so the default finite-difference step of 1e-12 would sit
         at round-off; 1e-7 is the square root of machine precision for unit-sized values. -->
    <Epsilon>1e-7</Epsilon>

    <Type>Static</Type>

    <Formulation>TotalLagrangian</Formulation>

    <StartTime>0</StartTime>
    <!-- The points-control plugin reads its coordinates as periodic in time with a period of 1,
         so at t = 1 it would prescribe the positions of t = 0 again. -->
    <StopTime>0.5</StopTime>
    <TimeStep>0.125</TimeStep>

    <Plugins>
        <PointsCtrl>true</PointsCtrl>
    </Plugins>
</Solver>

<Plugins>
    <PointsCtrl>
        <Points>
            <File>./tetgen/driven.txt</File>
        </Points>
        <Coordinates>
            <File>./tetgen/rotation.list</File>
        </Coordinates>
    </PointsCtrl>
</Plugins>
