<settings>P2P1 cantilever with a Robin boundary on its free end</settings>

<General>
    <LogFile>./Results/cantilever.log</LogFile>
</General>

<Mesh>
    <Type>T10P1</Type>
    <Format>Tetgen</Format>
    <Sorting>None</Sorting>

    <Tetgen>
        <Unit>1</Unit>
        <Nodes>./tetgen/cantilever.node</Nodes>
        <Elements>./tetgen/cantilever.ele</Elements>
        <Surfaces>./tetgen/cantilever.sur</Surfaces>
    </Tetgen>

    <Surfaces>
        <Surface_130><Type>T6</Type></Surface_130>
        <Surface_131><Type>CONTACT_ROBIN</Type></Surface_131>
    </Surfaces>
</Mesh>

<Materials>
    <Mat_30>
        <Type>NeoHooke</Type>
        <Density>1</Density>
        <NeoHooke>
            <a>1</a>
            <k>100</k>
        </NeoHooke>
        <TensionMax>0</TensionMax>
    </Mat_30>
</Materials>

<Export>
    <Format>VTK</Format>
    <Prefix>./Results/cantilever</Prefix>
    <TimeStep>0.25</TimeStep>
</Export>

<Solver>
    <NonZeros>2000</NonZeros>
    <DomainDecomposition>false</DomainDecomposition>
    <Precision>1e-10</Precision>
    <!-- Coordinates are O(1) here, so the default finite-difference step of 1e-12 would sit
         at round-off; 1e-7 is the square root of machine precision for unit-sized values. -->
    <Epsilon>1e-7</Epsilon>

    <Type>Static</Type>

    <Formulation>TotalLagrangian</Formulation>

    <StartTime>0</StartTime>
    <StopTime>1</StopTime>
    <TimeStep>0.25</TimeStep>

    <Plugins>
        <ApplyPressureFromFunction>true</ApplyPressureFromFunction>
        <RobinBoundaryGeneral>true</RobinBoundaryGeneral>
    </Plugins>
</Solver>

<Plugins>
    <ApplyPressureFromFunction>
        <ExportFile>./Results/Pressure.dat</ExportFile>
        <Groups>
            <Top>
                <Surfaces>130</Surfaces>
                <Intervals>
                    <Interval_1>
                        <Type>Linear</Type>
                        <Invert>false</Invert>
                        <StartTime>0.0</StartTime>
                        <StopTime>1.0</StopTime>
                        <Offset>0</Offset>
                        <Amplitude>0.003</Amplitude>
                    </Interval_1>
                </Intervals>
            </Top>
        </Groups>
    </ApplyPressureFromFunction>

    <!-- The plugin contributes no Jacobian, so Newton converges only linearly, at a rate set by
         the spring's share of the tip stiffness (about 0.01 here). A weak spring keeps it fast
         while still moving the tip measurably. No dashpot: a static step has no velocity. -->
    <RobinBoundaryGeneral>
        <SurfaceIndex>131</SurfaceIndex>
        <Alpha>0.002</Alpha>
        <Beta>0</Beta>
    </RobinBoundaryGeneral>
</Plugins>
