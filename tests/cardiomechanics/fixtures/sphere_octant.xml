<settings>Inflation of a thick-walled sphere octant</settings>

<General>
    <LogFile>./Results/sphere.log</LogFile>
</General>

<Mesh>
    <Type>T10P1</Type>
    <Format>Tetgen</Format>
    <Sorting>None</Sorting>

    <Tetgen>
        <Unit>1</Unit>
        <Nodes>./tetgen/sphere.node</Nodes>
        <Elements>./tetgen/sphere.ele</Elements>
        <Surfaces>./tetgen/sphere.sur</Surfaces>
    </Tetgen>

    <Surfaces>
        <Surface_101><Type>T6</Type></Surface_101>
    </Surfaces>
</Mesh>

<Materials>
    <Mat_30>
        <Type>NeoHooke</Type>
        <Density>1</Density>
        <NeoHooke>
            <a>1</a>
            <k>1000</k>
        </NeoHooke>
        <TensionMax>0</TensionMax>
    </Mat_30>
</Materials>

<Export>
    <Format>VTK</Format>
    <Prefix>./Results/sphere</Prefix>
    <TimeStep>1</TimeStep>
</Export>

<Solver>
    <!-- Preallocated entries per matrix row. A row of the P2P1 system has at most 338 on the finest
         mesh of the family; the default of 2000 would take gigabytes there. -->
    <NonZeros>400</NonZeros>
    <DomainDecomposition>false</DomainDecomposition>
    <!-- The measured discretization errors are 1e-4 and above, so the iteration stops far below them. -->
    <Precision>1e-10</Precision>
    <!-- Coordinates are O(1) here, so the default finite-difference step of 1e-12 would sit
         at round-off; 1e-7 is the square root of machine precision for unit-sized values. -->
    <Epsilon>1e-7</Epsilon>

    <Type>Static</Type>

    <Formulation>TotalLagrangian</Formulation>

    <StartTime>0</StartTime>
    <StopTime>1</StopTime>
    <TimeStep>0.25</TimeStep>

    <Plugins>
        <ApplyPressureFromFunction>true</ApplyPressureFromFunction>
    </Plugins>
</Solver>

<Plugins>
    <ApplyPressureFromFunction>
        <ExportFile>./Results/Pressure.dat</ExportFile>
        <Groups>
            <Cavity>
                <Surfaces>101</Surfaces>
                <Intervals>
                    <Interval_1>
                        <Type>Linear</Type>
                        <Invert>false</Invert>
                        <StartTime>0.0</StartTime>
                        <StopTime>1.0</StopTime>
                        <Offset>0</Offset>
                        <!-- A positive pressure acts along the face normal, which points out of the
                             wall into the cavity, so the inflating pressure is negative. -->
                        <Amplitude>-0.5</Amplitude>
                    </Interval_1>
                </Intervals>
            </Cavity>
        </Groups>
    </ApplyPressureFromFunction>
</Plugins>
